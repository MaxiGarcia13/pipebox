{
  "compilerOptions": {
    "target": "ESNext",
    "baseUrl": ".",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@unit-tests/*": ["./tests/unit/*"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "tests/**/*", "*.ts", "*.mts"]
}

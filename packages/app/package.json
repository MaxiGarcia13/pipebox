{
  "name": "@pipebox/app",
  "productName": "PipeBox",
  "type": "module",
  "version": "0.7.1",
  "private": true,
  "description": "Local CI/CD control panel for running GitHub Actions with Dockerized act.",
  "author": "Maximiliano Garcia Mortigliengo",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "prepackage": "node ./scripts/embed-runner.mjs",
    "package": "electron-forge package",
    "premake": "node ./scripts/embed-runner.mjs",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .vite node_modules dist out resources"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.6.0",
    "electron": "45.3.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

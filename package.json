{
  "name": "pipebox",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "description": "A lightweight desktop UI for running and debugging GitHub Actions and Jenkins pipelines locally with visual step-by-step logs—no git push required.",
  "author": "Maximiliano Garcia Mortigliengo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/pipebox.git"
  },
  "keywords": [
    "ci-cd",
    "github-actions",
    "jenkins",
    "act",
    "desktop-app",
    "developer-tools",
    "docker",
    "devops"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint . && pnpm -r --if-present run lint && pnpm runner:lint",
    "lint:fix": "eslint --fix . && pnpm -r --if-present run lint:fix && pnpm runner:lint:fix",
    "test": "pnpm runner:test",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules pnpm-lock.yaml",
    "phoenix": "pnpm clean && pnpm install",
    "app:start": "pnpm runner:build && pnpm -F @pipebox/app start",
    "runner:build": "make -C packages/runner build",
    "runner:test": "make -C packages/runner test",
    "runner:image": "make -C packages/runner image",
    "runner:lint": "make -C packages/runner lint",
    "runner:lint:fix": "make -C packages/runner lint-fix",
    "runner:doctor": "make -C packages/runner doctor"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.17.0",
    "eslint": "^10.14.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged"
  }
}

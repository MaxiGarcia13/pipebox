{
  "name": "pipebox",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Local CI/CD for GitHub Actions and Jenkins — run and debug pipelines from the desktop UI, terminal, or MCP. No git push required.",
  "author": "Maximiliano Garcia Mortigliengo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/pipebox.git"
  },
  "keywords": [
    "ci-cd",
    "github-actions",
    "jenkins",
    "act",
    "desktop-app",
    "developer-tools",
    "docker",
    "devops"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint . && pnpm -r --if-present run lint && pnpm runner:lint && pnpm mcp:lint",
    "lint:fix": "eslint --fix . && pnpm -r --if-present run lint:fix && pnpm runner:lint:fix && pnpm mcp:lint:fix",
    "test": "pnpm runner:test && pnpm mcp:test && pnpm app:test:unit",
    "test:e2e": "pnpm app:test:e2e",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules pnpm-lock.yaml",
    "phoenix": "pnpm clean && pnpm install",
    "start": "pnpm runner:build && pnpm -F @pipebox/app start",
    "app:test:unit": "pnpm -F @pipebox/app test:unit",
    "app:test:e2e": "pnpm -F @pipebox/app test:e2e",
    "runner:build": "make -C packages/runner build",
    "runner:test": "make -C packages/runner test",
    "runner:image": "make -C packages/runner image",
    "runner:lint": "make -C packages/runner lint",
    "runner:lint:fix": "make -C packages/runner lint-fix",
    "runner:doctor": "make -C packages/runner doctor",
    "mcp:build": "make -C packages/mcp build",
    "mcp:test": "make -C packages/mcp test",
    "mcp:lint": "make -C packages/mcp lint",
    "mcp:lint:fix": "make -C packages/mcp lint-fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.17.0",
    "eslint": "^10.14.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged"
  }
}
